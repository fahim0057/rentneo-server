PORT=5000

# MongoDB connection string. Use a database user scoped to this database.
MONGODB_URI=mongodb://user:password@localhost:27017/?authSource=admin
MONGODB_DB=rentneo
MONGODB_TIMEOUT_MS=10000

# Origin(s) allowed to call this API (comma-separated).
CLIENT_URL=http://localhost:3000

# Set only when running behind a reverse proxy (number of proxy hops).
# TRUST_PROXY=1

# Must match the client's BETTER_AUTH_URL exactly (JWT issuer/audience and JWKS host).
AUTH_URL=http://localhost:3000

# Stripe (test mode). Required only for checkout and webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
